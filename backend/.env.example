# X-RAY SQUARED — Backend environment configuration
# Copy this file to .env and adjust as needed.

# Path to the trained ResNet18 model (.pth).
MODEL_PATH=trained_models/pneumonia_resnet18_best.pth

# SQLite database URL.
DATABASE_URL=sqlite:///./xray_squared.db

# Upload + result directories.
UPLOAD_DIR=uploads
RESULT_DIR=results

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Confidence thresholds (prototype values, NOT clinically calibrated).
HIGH_CONFIDENCE_THRESHOLD=0.80
MEDIUM_CONFIDENCE_THRESHOLD=0.60

# Maximum upload size in MB.
MAX_UPLOAD_MB=10

# Server settings.
HOST=0.0.0.0
PORT=8000
